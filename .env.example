# --- Database ---
DATABASE_URL=postgresql+psycopg2://semantiq:semantiq@db:5432/semantiq

# --- Redis (query cache) ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Embeddings ---
# Runs locally, no API key needed
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Optional: LLM for answer synthesis (RAG) ---
# If left blank, /ask falls back to extractive answers (top chunks only)
ANTHROPIC_API_KEY=
